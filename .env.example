# Copy to .env and adjust. .env is git-ignored: never commit real secrets.

# --- AI engine ---
# mock = deterministic fake AI (free, used by tests and CI); live = real Claude calls.
AI_MODE=mock
# Required for AI_MODE=live. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=90

# --- Backend ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_TTL_MINUTES=720
AI_ENGINE_TIMEOUT_SECONDS=120
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
# Leave DB_* unset for in-memory H2 (scripts/dev-local.sh). docker-compose builds DB_URL from MYSQL_*.
# DB_URL=jdbc:mysql://localhost:3306/testpilot
# DB_USERNAME=testpilot
# DB_PASSWORD=change-me

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=testpilot
MYSQL_USER=testpilot
MYSQL_PASSWORD=change-me

# --- Frontend ---
# Empty = same origin (Nginx in Docker, Vite proxy in dev).
VITE_API_URL=
